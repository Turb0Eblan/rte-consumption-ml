{
  "datasets": [
    {
      "name": "22912a78",
      "displayName": "best_models_15d",
      "queryLines": [
        "SELECT\n",
        "  date,\n",
        "  estimator,\n",
        "  mape * 100 AS mape_pct,\n",
        "  logged_at\n",
        "FROM workspace.gold.best_models\n",
        "WHERE date >= current_date() - INTERVAL 15 DAYS\n",
        "QUALIFY ROW_NUMBER() OVER (PARTITION BY date ORDER BY logged_at DESC) = 1\n",
        "ORDER BY date"
      ]
    },
    {
      "name": "95451f8e",
      "displayName": "predictions_15d",
      "queryLines": [
        "SELECT\n",
        "  from_utc_timestamp(ts, 'Europe/Paris') AS ts_paris,\n",
        "  prediction_mw,\n",
        "  estimator,\n",
        "  predicted_on\n",
        "FROM workspace.gold.predictions\n",
        "WHERE ts >= current_date() - INTERVAL 15 DAYS\n",
        "QUALIFY ROW_NUMBER() OVER (PARTITION BY ts ORDER BY predicted_on DESC) = 1\n",
        "ORDER BY ts"
      ]
    }
  ],
